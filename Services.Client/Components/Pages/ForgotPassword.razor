@page "/forgot-password"
@layout AuthLayout
@inject IHttpClientFactory ClientFactory

<h3 class="text-center mb-4">Recuperar Contraseña</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<EditForm Model="model" OnValidSubmit="HandleForgotPassword" FormName="forgotPasswordForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Correo Electrónico:</label>
        <InputText class="form-control" @bind-Value="model.Email" placeholder="ejemplo@correo.com" />
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Enviar enlace de recuperación</button>

    <div class="text-center">
        <a href="/" class="text-decoration-none">Volver al inicio de sesión</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordDto model { get; set; } = new();
    private string? message;

    private async Task HandleForgotPassword()
    {
        var client = ClientFactory.CreateClient("AuthApi");
        var response = await client.PostAsJsonAsync("api/auth/forgot-password", model);
        message = "Si el correo está registrado, se ha enviado un enlace para restablecer tu contraseña.";
    }

    public class ForgotPasswordDto
    {
        public string Email { get; set; } = string.Empty;
    }
}