@page "/reset-password"
@layout AuthLayout
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<h3 class="text-center mb-4">Nueva Contraseña</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger">@message</div>
}

<EditForm Model="model" OnValidSubmit="HandleResetPassword" FormName="resetPasswordForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nueva Contraseña:</label>
        <InputText type="password" class="form-control" @bind-Value="model.NewPassword" />
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Restablecer Contraseña</button>

    <div class="text-center">
        <a href="/" class="text-decoration-none">Volver al inicio de sesión</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private ResetPasswordModel model { get; set; } = new();

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    private string? message;

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
        {
            message = "Parámetros de recuperación no válidos.";
            return;
        }

        try
        {
            var client = ClientFactory.CreateClient("AuthApi");
            var dto = new ResetPasswordDto(Email, Code, model.NewPassword);
            var response = await client.PostAsJsonAsync("api/auth/reset-password", dto);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/?reset=success");
            }
            else
            {
                message = "Error al restablecer la contraseña. Inténtalo nuevamente.";
            }
        }
        catch (Exception ex)
        {
            message = "Ocurrió un error al intentar conectar con el servidor.";
        }
    }

    public class ResetPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
    }

    public record ResetPasswordDto(string Email, string Code, string NewPassword);
}