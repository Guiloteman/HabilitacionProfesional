@page "/change-password"
@inject IHttpClientFactory ClientFactory

<div class="container mt-4" style="max-width: 400px;">
    <h3>Cambiar Contraseña</h3>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info">@message</div>
    }

    <EditForm Model="model" OnValidSubmit="HandleChangePassword" FormName="changePasswordForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Contraseña Actual:</label>
            <InputText type="password" class="form-control" @bind-Value="model.CurrentPassword" />
        </div>

        <div class="mb-3">
            <label>Nueva Contraseña:</label>
            <InputText type="password" class="form-control" @bind-Value="model.NewPassword" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Actualizar Contraseña</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private ChangePasswordDto model { get; set; } = new();
    private string? message;

    private async Task HandleChangePassword()
    {
        try
        {
            var client = ClientFactory.CreateClient("AuthApi");
            var response = await client.PostAsJsonAsync("api/auth/change-password", model);
            
            if (response.IsSuccessStatusCode)
            {
                message = "¡Contraseña actualizada exitosamente!";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            message = $"Error de conexión: {ex.Message}";
        }
    }

    public class ChangePasswordDto
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
    }
}