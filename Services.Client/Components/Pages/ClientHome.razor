@page "/client-home"
@layout EmptyLayout
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-white">¡Bienvenido a Servicios Ya!</h1>
        <p class="text-white-50">Selecciona uno de los servicios publicados por los prestadores y realiza su seguimiento en tiempo real.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg p-4 bg-white rounded-4 border-0">
                
                @if (cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Cargando servicios disponibles desde la base de datos...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @errorMessage
                    </div>
                    <div class="text-center">
                        <button class="btn btn-outline-primary btn-sm" @onclick="CargarServiciosAsync">🔄 Reintentar</button>
                    </div>
                }
                else if (string.IsNullOrEmpty(serviceIdSelected))
                {
                    <h4 class="mb-4 text-dark fw-bold text-center">Paso 1: Elige un Servicio Activo</h4>

                    <div class="mb-4">
                        <input type="text" 
                               class="form-control form-control-lg shadow-sm" 
                               placeholder="🔍 Buscar servicio por título o descripción..." 
                               @bind="searchTerm" 
                               @bind:event="oninput" 
                               @onkeyup="FiltrarServicios" />
                    </div>

                    @if (listaServicios == null || !listaServicios.Any())
                    {
                        <div class="text-center py-4">
                            <h5 class="text-muted">No se encontraron servicios que coincidan con la búsqueda.</h5>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var servicio in listaServicios)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 shadow-sm h-100 d-flex flex-column justify-content-between bg-light">
                                        <div>
                                            <h5 class="fw-bold text-primary">@servicio.Title</h5>
                                            <p class="text-muted small mb-2">@servicio.Description</p>
                                            <div class="mb-2">
                                                <span class="badge bg-success">Precio: $@servicio.Price</span>
                                            </div>
                                            <span class="text-muted font-monospace" style="font-size: 0.75rem;">ID: @servicio.Id</span>
                                        </div>
                                        <button class="btn btn-outline-primary w-100 fw-bold mt-3" @onclick="() => SeleccionarServicio(servicio.Id.ToString())">
                                            Seleccionar y Rastrear ➔
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-center">
                        <div class="alert alert-success py-3 mb-4 rounded-3 border-0 shadow-sm">
                            <h5 class="fw-bold text-success mb-1">¡Servicio Seleccionado con Éxito! 🎉</h5>
                            <p class="mb-0 text-muted small">ID del Servicio: <strong class="text-dark">@serviceIdSelected</strong></p>
                        </div>

                        <p class="text-muted small mb-4">El prestador está vinculado. Presiona el botón para enviar tu ubicación actual y abrir el mapa interactivo.</p>

                        <button class="btn btn-success btn-lg w-100 py-3 shadow-sm fw-bold mb-3" 
                                @onclick="IrAlSeguimiento" 
                                disabled="@obteniendoUbicacion">
                            @if (obteniendoUbicacion)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Obteniendo GPS y conectando...</span>
                            }
                            else
                            {
                                <span>🗺️ Enviar Mi Ubicación y Ver Trayecto en Vivo (GPS)</span>
                            }
                        </button>
                        
                        <div>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CambiarServicio">
                                ← Elegir otro servicio
                            </button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private bool cargando = true;
    private bool obteniendoUbicacion = false;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private string serviceIdSelected = string.Empty;
    private List<ServiceDto> listaServicios = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarServiciosAsync();
    }

    private async Task CargarServiciosAsync()
    {
        cargando = true;
        errorMessage = null;

        try
        {
            var client = ClientFactory.CreateClient("AuthApi");
            
            string url = "api/services";
            if (!string.IsNullOrEmpty(searchTerm))
            {
                url += $"?searchTerm={Uri.EscapeDataString(searchTerm)}";
            }

            var response = await client.GetFromJsonAsync<ServiceQueryResult>(url);
            
            if (response != null && response.Items != null)
            {
                listaServicios = response.Items;
            }
            else
            {
                listaServicios = await client.GetFromJsonAsync<List<ServiceDto>>(url) ?? new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al conectar con la API para obtener los servicios: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task FiltrarServicios()
    {
        await CargarServiciosAsync();
    }

    private void SeleccionarServicio(string id)
    {
        serviceIdSelected = id;
    }

    private async Task IrAlSeguimiento()
    {
        if (!string.IsNullOrWhiteSpace(serviceIdSelected))
        {
            try
            {
                obteniendoUbicacion = true;
                errorMessage = null;

                var coords = await JS.InvokeAsync<CoordsDto>("obtenerCoordenadasActuales");

                var client = ClientFactory.CreateClient("AuthApi");
                
                var payload = new 
                {
                    Latitude = coords.Latitude,
                    Longitude = coords.Longitude
                };

                var response = await client.PostAsJsonAsync($"api/services/{serviceIdSelected}/request", payload);

                if (response.IsSuccessStatusCode)
                {
                    Navigation.NavigateTo($"/track/{serviceIdSelected.Trim()}");
                }
                else
                {
                    errorMessage = "No se pudo registrar la ubicación en el servicio. Inténtalo de nuevo.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al obtener la geolocalización o conectar con la API: {ex.Message}";
            }
            finally
            {
                obteniendoUbicacion = false;
            }
        }
    }

    private void CambiarServicio()
    {
        serviceIdSelected = string.Empty;
        errorMessage = null;
    }

    public class ServiceDto
{
    public Guid Id { get; set; }
    public string Title { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public Guid ProviderId { get; set; }
    public decimal Latitude { get; set; }
    public decimal Longitude { get; set; }
    public decimal? ProviderLatitude { get; set; }
    public decimal? ProviderLongitude { get; set; }
}

    public class ServiceQueryResult
    {
        public List<ServiceDto> Items { get; set; } = new();
    }

    public class CoordsDto
    {
        public decimal Latitude { get; set; }
        public decimal Longitude { get; set; }
    }
}