@page "/provider/jobs"
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container py-4">
    <h3 class="mb-4 text-center">Panel de Trabajos del Prestador 🛠️</h3>

    @if (isLoading)
    {
        <div class="text-center">
            <p>Cargando trabajos asignados...</p>
        </div>
    }
    else if (services == null || !services.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No tienes servicios o trabajos activos en este momento.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var service in services)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@service.Title</h5>
                            <p class="card-text text-muted">@service.Description</p>
                            <p class="card-text"><strong>Precio:</strong> $@service.Price</p>
                            
                            <button class="btn btn-success w-100" @onclick="() => IrAlMapa(service.Id)">
                                Abrir Mapa en Vivo y Rastrear 📍
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServiceItemDto> services = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("AuthApi");

            var pagedResult = await client.GetFromJsonAsync<PagedResult<ServiceItemDto>>("api/services");

            services = pagedResult?.Items ?? new List<ServiceItemDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar los trabajos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class PagedResult<T>
    {
        public List<T> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }

    private void IrAlMapa(Guid serviceId)
    {
        Navigation.NavigateTo($"/provider/track/{serviceId}");
    }

    public class ServiceItemDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
    }
}