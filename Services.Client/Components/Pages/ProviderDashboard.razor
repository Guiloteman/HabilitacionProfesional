    @page "/provider/dashboard"
    @rendermode InteractiveServer
    @inject IHttpClientFactory ClientFactory
    @inject NavigationManager Navigation
    @inject IJSRuntime JS

    <div class="container-fluid mt-4">
        <h3 class="fw-bold text-white mb-4">Panel del Prestador - Trabajo Asignado 🗺️</h3>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="text-white-50 mt-2">Buscando solicitudes pendientes...</p>
            </div>
        }
        else if (assignedJob == null)
        {
            <div class="alert alert-dark shadow-sm p-4 border border-secondary text-center">
                <h4 class="text-white">No tienes ningún servicio asignado en este momento.</h4>
                <p class="text-white-50">Permanece a la espera. Cuando un cliente solicite una asistencia, aparecerá reflejada aquí automáticamente.</p>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6 mx-auto">
                    <div class="card shadow bg-dark text-white border-secondary">
                        <div class="card-body">
                            <h5 class="card-title text-warning">¡Nueva Solicitud de Servicio!</h5>
                            <hr class="border-secondary" />
                            <p><strong>Título:</strong> @assignedJob.Title</p>
                            <p><strong>Descripción:</strong> @assignedJob.Description</p>
                            <p><strong>Precio Estimado:</strong> <span class="text-success fw-bold">$@assignedJob.Price</span></p>
                        
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger py-2">@errorMessage</div>
                            }

                            <button class="btn btn-success w-100 mt-3 py-2 fw-bold" @onclick="AceptarServicio">
                                Aceptar y En Camino 🚗
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @code {
    private bool isLoading = true;
    private ServiceItemDto? assignedJob;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarServicioAsignadoAsync();
    }

    private async Task CargarServicioAsignadoAsync()
    {
        isLoading = true;
        try
        {
            var client = ClientFactory.CreateClient("AuthApi");
            assignedJob = await client.GetFromJsonAsync<ServiceItemDto>("api/services/my-active-job");
        }
        catch (Exception)
        {
            assignedJob = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AceptarServicio()
{
    if (assignedJob == null) return;

    errorMessage = null;
    try
    {
        var coords = await JS.InvokeAsync<CoordsDto>("obtenerCoordenadasActuales");

        var client = ClientFactory.CreateClient("AuthApi");
        
        var payload = new 
        {
            ProviderLatitude = coords.Latitude,
            ProviderLongitude = coords.Longitude
        };

        var response = await client.PutAsJsonAsync($"api/services/{assignedJob.Id}/accept", payload);
        
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/provider/active-job");
        }
        else
        {
            var errorContent = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = errorContent?.Message ?? "No se pudo aceptar el servicio.";
        }
    }
    catch (Exception ex)
    {
        errorMessage = $"Error al obtener GPS o de red: {ex.Message}";
    }
}

public class CoordsDto
{
    public decimal Latitude { get; set; }
    public decimal Longitude { get; set; }
}

    public class ServiceItemDto
{
    public Guid Id { get; set; }
    public string Title { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public Guid ProviderId { get; set; }
    public decimal Latitude { get; set; }
    public decimal Longitude { get; set; }
    public decimal? ProviderLatitude { get; set; }
    public decimal? ProviderLongitude { get; set; }
}

    public class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}