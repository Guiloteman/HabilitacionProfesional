@page "/provider/dashboard"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@using Services.Application.DTOs
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization

<div class="container py-4">
    <h3 class="fw-bold text-dark mb-4">Servicios Disponibles para Tomar</h3>

    <!-- 🔍 BARRA DE BÚSQUEDA INTERACTIVA -->
    <div class="mb-4">
        <input type="text"
               class="form-control form-control-lg shadow-sm"
               placeholder="🔍 Buscar servicio disponible por título o descripción..."
               @bind="searchTerm"
               @bind:event="oninput"
               @onkeyup="FiltrarServicios" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            <strong>⚠️ Error:</strong> @errorMessage
        </div>
    }

    @if (services == null && string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-muted">Cargando servicios...</p>
    }
    else if (services != null && !services.Any())
    {
        <div class="alert alert-info" role="alert">
            No hay servicios pendientes que coincidan con la búsqueda.
        </div>
    }
    else if (services != null)
    {
        <div class="list-group">
            @foreach (var service in services)
            {
                <div class="list-group-item bg-light text-dark border mb-3 p-3 rounded shadow-sm">
                    <h5>@service.Title</h5>
                    <p class="mb-1 text-muted">@service.Description</p>
                    <p class="text-success fw-bold">Precio estimado: $@service.Price</p>

                    <button class="btn btn-success mt-2" @onclick="() => AceptarServicio(service.Id)">
                        Aceptar y En Camino 🚗
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServiceItemDto>? services;
    private string searchTerm = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarServiciosAsync();
    }

    private async Task CargarServiciosAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("AuthApi");

            string url = "api/services";
            if (!string.IsNullOrEmpty(searchTerm))
            {
                url += $"?searchTerm={Uri.EscapeDataString(searchTerm)}";
            }

            var options = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            var pagedResult = await client.GetFromJsonAsync<PagedResult<ServiceItemDto>>(url, options);

            services = pagedResult?.Items ?? new List<ServiceItemDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al invocar la API: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private async Task FiltrarServicios()
    {
        await CargarServiciosAsync();
    }

    private async Task AceptarServicio(Guid serviceId)
    {
        try
        {
            // Obtenemos el ID del prestador actual desde el estado de autenticación de Blazor
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var providerId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(providerId))
            {
                errorMessage = "No se pudo identificar al prestador logueado.";
                return;
            }

            var client = ClientFactory.CreateClient("AuthApi");

            // Enviamos el providerId por la URL
            var response = await client.PutAsync($"api/services/{serviceId}/accept?providerId={providerId}", null);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/provider/track/{serviceId}");
            }
            else
            {
                errorMessage = "No se pudo aceptar el servicio. Inténtalo de nuevo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de red: {ex.Message}";
        }
    }

    public class PagedResult<T>
    {
        public List<T> Items { get; set; } = new();
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
        public int TotalPages { get; set; }
    }
}