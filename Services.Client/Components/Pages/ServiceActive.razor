@page "/service-active/{ServiceId}"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<div class="container text-center py-5">
    <h3>Modo de ruta activo</h3>
    <p>Compartiendo ubicación en tiempo real...</p>

    <div id="map" class="map-theme-dark shadow border mt-3" style="height: 450px; width: 100%; border-radius: 12px;"></div>

    <div class="spinner-border text-success mt-3" role="status"></div>
</div>

@code {
    [Parameter]
    public string ServiceId { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(200);
                var apiBase = Configuration["Api:BaseUrl"] ?? Navigation.ToAbsoluteUri("/").ToString();
                var hubUrl = $"{apiBase.TrimEnd('/')}/locationHub";
                Console.WriteLine($"Conectando cliente al Hub en: {hubUrl}");

                await JS.InvokeVoidAsync("showMapStatus", "Conectando al prestador...");
                await JS.InvokeVoidAsync("iniciarEscuchaCliente", ServiceId, hubUrl);
                await JS.InvokeVoidAsync("showMapStatus", "Conectado. Esperando ubicación...");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}