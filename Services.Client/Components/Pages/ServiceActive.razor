@page "/service-active/{ServiceId}"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<div class="container text-center py-5">
    <h3>Modo de ruta activo</h3>
    <p>Compartiendo ubicación en tiempo real...</p>
    <div class="spinner-border text-success" role="status"></div>
</div>

@code {
    [Parameter]
    public string ServiceId { get; set; } = string.Empty;

    private HubConnection? hubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                hubConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri("/locationHub"))
                    .Build();

                await hubConnection.StartAsync();
                await hubConnection.SendAsync("JoinServiceGroup", ServiceId);

                // Invocar la función JS correcta para que el CLIENTE escuche la ubicación del prestador
                // El Hub de SignalR está hospedado en la API (puerto 7245 en desarrollo)
                // Obtener la URL del API (hub) desde configuración
                var apiBase = Configuration["Api:BaseUrl"] ?? Navigation.ToAbsoluteUri("/").ToString();
                var hubUrl = $"{apiBase.TrimEnd('/')}/locationHub";
                Console.WriteLine($"Conectando cliente al Hub en: {hubUrl}");
                // Mostrar un pequeño indicador en la UI para indicar que estamos conectando
                await JS.InvokeVoidAsync("showMapStatus", "Conectando al prestador...");
                await JS.InvokeVoidAsync("iniciarEscuchaCliente", ServiceId, hubUrl);
                await JS.InvokeVoidAsync("showMapStatus", "Conectado. Esperando ubicación...");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task SendCoordinates(double latitude, double longitude)
    {
        if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
        {
            await hubConnection.SendAsync("SendLocation", ServiceId, latitude, longitude);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}